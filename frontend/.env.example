# Salin ke .env.local bila perlu mengubah default.

# Alamat backend Golang untuk proxy dev server Vite (/api → backend). Default: http://localhost:8081
MEDCREDIX_API_URL=http://localhost:8081

# Base URL API saat build bila frontend & backend beda origin (CORS backend sudah mengizinkan *).
# Kosongkan untuk same-origin (proxy Vite atau mode single-binary MEDCREDIX_STATIC).
VITE_API_BASE=

# "true" = mode demo statis tanpa backend (data di browser).
VITE_DEMO_MODE=false
