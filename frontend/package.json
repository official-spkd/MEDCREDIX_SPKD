{
  "name": "spkd-medcredix",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "SPKD MedCredix — Medical Credentialing Intelligence Platform (Vue 3 + Vite + Golang)",
  "scripts": {
    "dev": "vite 2>&1 | tee dev.log",
    "dev:demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "db:push": "echo '[MedCredix] Database dikelola backend Golang (backend/data/medcredix.db) - auto-migrate + seed saat server mulai.'",
    "api:dev": "cd ../backend && go run ./cmd/server",
    "api:build": "cd ../backend && go build -o medcredix-api ./cmd/server"
  },
  "dependencies": {
    "@vueuse/core": "^13.9.0",
    "chart.js": "^4.5.0",
    "lucide-vue-next": "^0.545.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.25",
    "vue-chartjs": "^5.3.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@vitejs/plugin-vue": "^6.0.1",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.12",
    "vue-tsc": "^3.1.0"
  }
}
